# The operator console's build-time settings.
#
# Copy to apps/portal/.env. These are baked into the bundle by `vite build`, so
# changing one means rebuilding — editing the deployed file is not a
# configuration mechanism. Nothing here is a secret, because a browser cannot
# hold one.

# Where the API is, as the BROWSER reaches it. Not a compose service name.
VITE_API_BASE_URL=http://localhost:3000

# The identity provider, as the BROWSER reaches it.
#
# This must be byte-identical to the service's own OIDC_ISSUER, because
# mock-oauth2-server issues tokens whose `iss` is the address the browser used,
# and the service compares that string. If the two differ, sign-in fails with a
# 401 that says nothing about why.
VITE_OIDC_ISSUER=http://localhost:8090/baas

VITE_OIDC_CLIENT_ID=baas-portal
