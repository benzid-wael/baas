# baas — local development environment.
#
# Copy to .env. Every value here is deliberately fake: the secrets contain
# placeholder markers that stage and production refuse, so this file cannot be
# promoted by accident. See RFC-BaaS §5.5.

# ---------------------------------------------------------------- deployment
# The tier. Drives every hardening rule. NOT NODE_ENV, which the image pins to
# "production" and therefore cannot distinguish environments.
APP_ENV=dev
PORT=3000
LOG_LEVEL=debug
# BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
OPENAPI_ENABLED=true

# ------------------------------------------------------------------ database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=baas
DATABASE_PASSWORD=changeme-local-development-only
DATABASE_NAME=baas
# Required true in stage and production. Left off locally because the compose
# Postgres has no certificate.
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=true
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ throttle
# Must be "redis" in stage and production: in-memory throttling does not
# survive more than one replica, which makes it not a rate limit.
THROTTLE_STORAGE=memory
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------- observability
SERVICE_NAME=baas
# Required in stage and production. Elastic, not Datadog.
# APM_SERVER_URL=https://apm.nrml.tools

# ---------------------------------------------------------- mobile assertion
# The BFF signs a short-lived ES256 assertion per request; baas holds only the
# public key. Required in EVERY tier including dev, so that the BFF change to
# mint `iss` and `aud` is made here where it is cheap, rather than discovered
# in stage where it 401s every mobile request.
#
# Single-line base64 of the PEM. A multi-line PEM does not survive the dev
# bridge and fails as "must be an asymmetric key" several layers from the cause.
MOBILE_ASSERTION_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFcWhUS1BnWVpjWUQ3Vys1WXdTZXFXb1U1cHZQWQpOelVtY3poL0tqT3FDL2orSEJKY3AxTUFKbWNMOWw3OWM2V01QWmI4VnhQa1BCU1gwYXN2ZE5ZWmhnPT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg==
MOBILE_ASSERTION_ISSUER=https://bff.local.superchat.internal
MOBILE_ASSERTION_AUDIENCE=baas

# -------------------------------------------------------- operator sign-in
# `docker compose --profile infra up -d` runs mock-oauth2-server, which issues
# real tokens against a real JWKS endpoint and accepts any login. It is
# obviously not an identity provider, which is the point: nobody will mistake
# it for one.
#
# Issuer and JWKS URI differ deliberately. The issuer is a string compared
# against a token's `iss`, which is whatever the *browser* saw; the JWKS URI is
# a URL this service fetches, which in compose is a container name.
OIDC_ISSUER=http://localhost:8090/baas
OIDC_AUDIENCE=baas-portal
OIDC_JWKS_URI=http://oidc:8080/baas/jwks
# When api/worker run on your machine rather than in compose:
# OIDC_JWKS_URI=http://localhost:8090/baas/jwks

# Subjects granted `admin` on first sign-in, once, with an audit row. Seed two:
# dual control needs two people, and the incumbent deadlocked three workflows
# with one (finding C3).
OPERATOR_BOOTSTRAP_ADMIN_SUBJECTS=first-operator,second-operator

# ------------------------------------------------------------------- secrets
# No secret has a schema default, in any tier. These are placeholders and are
# rejected outside dev.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=changeme-placeholder-key-32-chars!
# Callback credentials are per provider, not global: Keel is verified with its
# PUBLIC KEY and Ruya with a SHARED SECRET, which are not the same kind of
# thing. See the provider block below.

# -------------------------------------------------------------------- tenant
# One tenant today, from the environment. When the `tenant` table exists (T6)
# this comes from the database and nothing that consumes it changes.
BOOTSTRAP_TENANT_SLUG=superchat
BOOTSTRAP_TENANT_NAME=Superchat

# Providers are declared as a list and read generically, so adding one is a
# manifest change rather than a schema change. Required outside dev: a tenant
# with no provider can hold no money.
PROVIDERS=
# PROVIDERS=keel,ruya

# Read from the prefix PROVIDER_<NAME>_, so adding a provider is a manifest
# change. Four keys are common to every provider; the rest are what a
# particular adapter needs, and the provider registry — not this file and not
# the schema — decides which of them are required. A provider named above with
# a required key missing reports `not_configured` in dev and REFUSES TO BOOT in
# stage and production.

# -- Keel
# PROVIDER_KEEL_BASE_URL=
# PROVIDER_KEEL_CLIENT_ID=
# PROVIDER_KEEL_CLIENT_SECRET=
# PROVIDER_KEEL_HTTP_TIMEOUT_MS=10000
# Keel's OAuth token endpoint is NOT the base URL.
# PROVIDER_KEEL_ACCESS_TOKEN_ENDPOINT=
# PEM, or single-line base64 of one. Required: without it every non-GET is
# rejected with a message that says nothing about signatures.
# PROVIDER_KEEL_SIGNING_PRIVATE_KEY=
# A pre-issued token, for a sandbox that does not run OAuth.
# PROVIDER_KEEL_BEARER_TOKEN=
# Keel's PUBLIC key, used to verify its callbacks. Not a secret, and not the
# same key as the signing key above. Without it every delivery is recorded as
# unverified -- never accepted.
# PROVIDER_KEEL_WEBHOOK_PUBLIC_KEY=

# -- Ruya (TCS BaNCS)
# PROVIDER_RUYA_BASE_URL=
# PROVIDER_RUYA_CLIENT_ID=
# PROVIDER_RUYA_CLIENT_SECRET=
# PROVIDER_RUYA_HTTP_TIMEOUT_MS=10000
# BaNCS demands these four on every call and answers unhelpfully without them.
# PROVIDER_RUYA_ENTITY=
# PROVIDER_RUYA_LANGUAGE_CODE=
# PROVIDER_RUYA_USER_ID=
# PROVIDER_RUYA_CHANNEL_ID=
# PROVIDER_RUYA_TOKEN_REFRESH_BUFFER_SECONDS=60
# PROVIDER_RUYA_MAX_RETRIES=2
# Shared secret for callback HMAC, >= 32 characters, agreed with the sender.
# Without it every delivery is recorded as unverified -- never accepted.
# PROVIDER_RUYA_CALLBACK_HMAC_SECRET=
