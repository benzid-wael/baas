# baas — local development environment.
#
# Copy to .env. Every value here is deliberately fake: the secrets contain
# placeholder markers that stage and production refuse, so this file cannot be
# promoted by accident. See RFC-BaaS §5.5.

# ---------------------------------------------------------------- deployment
# The tier. Drives every hardening rule. NOT NODE_ENV, which the image pins to
# "production" and therefore cannot distinguish environments.
APP_ENV=dev
PORT=3000
LOG_LEVEL=debug
# BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
OPENAPI_ENABLED=true

# ------------------------------------------------------------------ database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=baas
DATABASE_PASSWORD=changeme-local-development-only
DATABASE_NAME=baas
# Required true in stage and production. Left off locally because the compose
# Postgres has no certificate.
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=true
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ throttle
# Must be "redis" in stage and production: in-memory throttling does not
# survive more than one replica, which makes it not a rate limit.
THROTTLE_STORAGE=memory
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------- observability
SERVICE_NAME=baas
# Required in stage and production. Elastic, not Datadog.
# APM_SERVER_URL=https://apm.nrml.tools

# ---------------------------------------------------------- mobile assertion
# The BFF signs a short-lived ES256 assertion per request; baas holds only the
# public key. Required in EVERY tier including dev, so that the BFF change to
# mint `iss` and `aud` is made here where it is cheap, rather than discovered
# in stage where it 401s every mobile request.
#
# Single-line base64 of the PEM. A multi-line PEM does not survive the dev
# bridge and fails as "must be an asymmetric key" several layers from the cause.
MOBILE_ASSERTION_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFcWhUS1BnWVpjWUQ3Vys1WXdTZXFXb1U1cHZQWQpOelVtY3poL0tqT3FDL2orSEJKY3AxTUFKbWNMOWw3OWM2V01QWmI4VnhQa1BCU1gwYXN2ZE5ZWmhnPT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg==
MOBILE_ASSERTION_ISSUER=https://bff.local.superchat.internal
MOBILE_ASSERTION_AUDIENCE=baas

# ------------------------------------------------------------------- secrets
# No secret has a schema default, in any tier. These are placeholders and are
# rejected outside dev.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=changeme-placeholder-key-32-chars!
CALLBACK_HMAC_SECRET=changeme-placeholder-hmac-32-char

# -------------------------------------------------------------------- tenant
# One tenant today, from the environment. When the `tenant` table exists (T6)
# this comes from the database and nothing that consumes it changes.
BOOTSTRAP_TENANT_SLUG=superchat
BOOTSTRAP_TENANT_NAME=Superchat

# Providers are declared as a list and read generically, so adding one is a
# manifest change rather than a schema change. Required outside dev: a tenant
# with no provider can hold no money.
PROVIDERS=
# PROVIDERS=keel,ruya
# PROVIDER_KEEL_BASE_URL=
# PROVIDER_KEEL_CLIENT_ID=
# PROVIDER_KEEL_CLIENT_SECRET=
